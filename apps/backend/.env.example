# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword

# Environment Configuration
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050
FRONTEND_RESET_PASSWORD_ROUTE=reset-password

# Database Configuration
DATABASE_URL=postgresql://quacker:quacker@localhost:5433/quacker

# Server Configuration
PORT=4050

# Mail Configuration
# Resolution order (first match wins): Resend → SMTP → ConsoleMailerAdapter (dev logs).
# Set RESEND_API_KEY to use Resend.
RESEND_API_KEY=
EMAIL_FROM="Quacker <onboarding@resend.dev>"
# Or set all three SMTP_* (HOST, USERNAME, PASSWORD) to use SMTP instead.
# Mailjet: SMTP_HOST=in-v3.mailjet.com, SMTP_PORT=587, SMTP_SECURE=false,
# USERNAME = API key, PASSWORD = secret key, SMTP_FROM = a validated sender.
SMTP_HOST=
SMTP_SECURE=true
SMTP_PORT=465
SMTP_USERNAME=
# Sender of SMTP mail; empty = the user name. Set it where that is not an address (Mailjet).
SMTP_FROM=
SMTP_PASSWORD=

# E-mail outbox (F-09.5, ADR-0018). Every e-mail is queued in the database and
# a poller sends it. At most EMAIL_DAILY_LIMIT in any 24 hours, of which the
# reserve percentage only critical ones (sign-in, changed/cancelled event) may
# use; at most EMAIL_RECIPIENT_HOURLY_LIMIT non-critical ones per person.
EMAIL_DAILY_LIMIT=200
EMAIL_CRITICAL_RESERVE_PERCENT=20
EMAIL_RECIPIENT_HOURLY_LIMIT=10
EMAIL_POLL_INTERVAL_MS=5000