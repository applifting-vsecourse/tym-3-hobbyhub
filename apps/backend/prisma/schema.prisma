// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Doménový model (wiki: Domenovy-model). Names follow the model; derived
// attributes ("/freeSpots", "/approvedCount", …) are computed in code.
//
// Prisma cannot express CHECK constraints, so they are invisible here. They
// live in the SQL migrations (mostly `akce_schema`, user addresses in
// `user_location_all_or_nothing`) and are covered by `event-schema.spec.ts`.
// Keep that in mind when writing the next migration.
// ---------------------------------------------------------------------------

enum Language {
  CS
  EN

  @@map("language")
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  BLOCKED
  DELETED

  @@map("user_status")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum NotificationType {
  NEW_REQUESTS
  PARTICIPANT_CANCELLED
  REQUEST_DECIDED
  CONFIRMATION_PROMPT
  SPOT_AVAILABLE
  GROUP_INVITATION
  EVENT_BOARD
  ONBOARDING_SERIES
  MONTHLY_RECOMMENDATION

  @@map("notification_type")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
  NOT_HELD

  @@map("event_status")
}

enum EventVisibility {
  PUBLIC
  GROUP_ONLY
  PRIVATE

  @@map("event_visibility")
}

enum ApprovalMode {
  MANUAL
  AUTOMATIC

  @@map("approval_mode")
}

enum VenueType {
  PUBLIC_VENUE
  PRIVATE_VENUE
  ONLINE

  @@map("venue_type")
}

enum ParticipationStatus {
  APPROVED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
  INVITED
  DECLINED

  @@map("participation_status")
}

// ADR-0003, ADR-0008: a request has its own life cycle, decided by the
// organizer. WITHDRAWN: the applicant cancelled it while it was pending.
// CLOSED: closed without a decision because the event was cancelled.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CLOSED

  @@map("request_status")
}

enum GroupVisibility {
  PUBLIC
  PRIVATE

  @@map("group_visibility")
}

enum GroupStatus {
  ACTIVE
  CANCELLED

  @@map("group_status")
}

// OWNER is the founder: one per group, with every right an ADMIN has and more.
// Check admin rights with `hasGroupAdminRights`, never `role === 'ADMIN'`.
enum GroupRole {
  OWNER
  ADMIN
  MEMBER

  @@map("group_role")
}

// Lookup tables ----------------------------------------------------------

model ActivityCategory {
  id         String     @id @default(cuid())
  name       String     @unique @db.VarChar(100)
  activities Activity[]

  @@map("activity_category")
}

model Activity {
  id                     String           @id @default(cuid())
  category               ActivityCategory @relation(fields: [categoryId], references: [id])
  categoryId             String
  name                   String           @unique @db.VarChar(100)
  // Key of the icon in the frontend (`ACTIVITIES` in ActivityIcon.tsx).
  icon                   String           @db.VarChar(50)
  defaultMinParticipants Int
  defaultMaxParticipants Int
  isActive               Boolean          @default(true)
  events                 Event[]
  groups                 Group[]
  interests              UserActivity[]

  @@index([categoryId])
  @@map("activity")
}

// An activity the user likes to play and how well (F-04.1, F-04.8).
model UserActivity {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  activity   Activity @relation(fields: [activityId], references: [id])
  activityId String
  // Optional: nobody has to rate themselves to say what they play. From the
  // Level catalogue (ADR-0002), the ones flagged isSkillLevel.
  level      Level?   @relation(fields: [levelId], references: [id], onDelete: Restrict)
  levelId    String?

  @@id([userId, activityId])
  @@index([activityId])
  @@index([levelId])
  @@map("user_activity")
}

model Level {
  id             String         @id @default(cuid())
  name           String         @unique @db.VarChar(100)
  order          Int            @unique
  // False for "Všechny úrovně": it describes an event, not how well a person plays.
  isSkillLevel   Boolean        @default(true)
  events         Event[]
  userActivities UserActivity[]

  @@map("level")
}

model CancellationReason {
  id     String  @id @default(cuid())
  name   String  @unique @db.VarChar(200)
  events Event[]

  @@map("cancellation_reason")
}

// Groups (F-07) ------------------------------------------------------------

// Only what F-07.1 needs; tags, approval, invitations and moderation come
// with their features.
model Group {
  id String @id @default(cuid())

  name          String          @db.VarChar(80)
  description   String          @db.Text
  // Model datatype `Location` needs coordinates, which need geocoding. Until
  // that exists the place is free text ("Praha 8", "Brno-Žabovřesky").
  locationName  String?         @db.VarChar(100)
  usualSchedule String?         @db.VarChar(100)
  // F-07.1: every group is public for now; PRIVATE arrives with F-07.1b.
  visibility    GroupVisibility @default(PUBLIC)
  status        GroupStatus     @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  activity           Activity            @relation(fields: [activityId], references: [id])
  activityId         String
  memberships        GroupMembership[]
  membershipRequests MembershipRequest[]
  events             Event[]

  @@index([activityId])
  @@map("group")
}

// Exactly one OWNER per group: a partial unique index in the migration.
model GroupMembership {
  id       String    @id @default(cuid())
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  // A user is in a group at most once.
  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_membership")
}

// F-07.3, ADR-0008: a request to join a group, decided by its admins. Same
// life cycle as ParticipationRequest; CLOSED is not used for groups yet. One
// PENDING request per person and group, and the CHECKs: a partial unique index
// and constraints in the migration.
model MembershipRequest {
  id String @id @default(cuid())

  status          RequestStatus @default(PENDING)
  message         String?       @db.VarChar(500)
  rejectionReason String?       @db.VarChar(500)
  requestedAt     DateTime      @default(now())
  decidedAt       DateTime?

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@index([groupId, status])
  @@index([userId])
  @@map("membership_request")
}

// Event & Participation ---------------------------------------------------

model Event {
  id String @id @default(cuid())

  title       String  @db.VarChar(200)
  description String  @db.Text
  equipment   String? @db.Text
  notes       String? @db.Text
  imageUrl    String? @db.Text

  status       EventStatus     @default(DRAFT)
  visibility   EventVisibility @default(PUBLIC)
  approvalMode ApprovalMode    @default(MANUAL)
  venueType    VenueType

  startAt     DateTime
  endAt       DateTime
  publishedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  minParticipants       Int
  maxParticipants       Int
  // People already coming who are not on the app (friends, a whole team).
  externalOccupiedSpots Int @default(0)

  // Fill deadline: X hours before the start. Empty until the deadline feature
  // arrives (out of scope of F-05.1).
  fillDeadlineHours             Int?
  freeCancellationHours         Int?
  confirmationRequestDaysBefore Int?
  // F-05.1 contribution per seat, information only: an amount in CZK and a
  // note such as "platí se na místě".
  contributionAmount            Decimal? @db.Decimal(10, 2)
  contributionNote              String?  @db.VarChar(200)

  // F-05.2 / F-05.4 private event via an invitation link.
  inviteToken     String? @unique @db.VarChar(100)
  // F-06.5 link to an external group chat.
  externalChatUrl String? @db.Text
  // Shown to APPROVED participants only.
  onlineUrl       String? @db.Text
  // F-11.3, F-11.4 hidden by an administrator.
  isHidden        Boolean @default(false)

  // Model datatype `Location`, stored as columns. The address is all-or-nothing
  // (see the CHECK constraints in the migration); an ONLINE event has none.
  // Coordinates are optional until geocoding exists (F-12.3): F-05.1 takes a
  // structured address without a map.
  locationStreet     String?  @db.VarChar(200)
  locationCity       String?  @db.VarChar(100)
  locationPostalCode String?  @db.VarChar(20)
  locationCountry    String?  @db.VarChar(100)
  locationDistrict   String?  @db.VarChar(100)
  locationPlaceName  String?  @db.VarChar(200)
  locationLatitude   Decimal? @db.Decimal(9, 6)
  locationLongitude  Decimal? @db.Decimal(9, 6)

  activity              Activity               @relation(fields: [activityId], references: [id])
  activityId            String
  level                 Level?                 @relation(fields: [levelId], references: [id])
  levelId               String?
  // ON DELETE RESTRICT (default): a user who organized an event cannot be
  // hard-deleted. Account deletion is soft (`UserStatus.DELETED`); participations
  // and co-organizing cascade, organizing does not.
  organizer             User                   @relation("EventOrganizer", fields: [organizerId], references: [id])
  organizerId           String
  coOrganizers          User[]                 @relation("EventCoOrganizers")
  copiedFrom            Event?                 @relation("EventCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copiedFromId          String?
  copies                Event[]                @relation("EventCopies")
  cancellationReason    CancellationReason?    @relation(fields: [cancellationReasonId], references: [id])
  cancellationReasonId  String?
  participations        Participation[]
  participationRequests ParticipationRequest[]
  // F-02.5: the group that organizes the event; optional, set to null when
  // the group is deleted.
  group                 Group?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId               String?

  @@index([organizerId])
  @@index([activityId])
  @@index([groupId])
  @@index([status, visibility, startAt])
  @@map("event")
}

model Participation {
  id String @id @default(cuid())

  status             ParticipationStatus
  // Set exactly while the status is WAITLISTED.
  waitlistPosition   Int?
  // Deadline to accept: a substitute (F-05.9) or an invited group member.
  offerExpiresAt     DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  isLateCancellation Boolean             @default(false)
  checkInCode        String?             @db.VarChar(20)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  // A person is on an event's roster once.
  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
  @@map("participation")
}

// F-06.1 request to join an event (ADR-0003). It takes no seat; the
// participation that does comes from approving it (F-05.7).
// At most one PENDING request per person and event: a partial unique index in
// the migration. `decidedAt` is set exactly when the status is not PENDING.
model ParticipationRequest {
  id String @id @default(cuid())

  status      RequestStatus @default(PENDING)
  message     String?       @db.VarChar(500)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?
  // F-05.7 optional, only on REJECTED (ADR-0008). Not shown anywhere yet.
  rejectionReason String?   @db.VarChar(500)

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@index([eventId, status])
  @@index([userId])
  @@map("participation_request")
}

model Quack {
  id        String   @id @default(cuid())
  text      String   @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("quack")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// BetterAuth rate limiter (F-03.4): one row per IP and path.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?   @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  quacks        Quack[]
  role          UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  // Profile fields from the domain model. BetterAuth keeps name, email,
  // emailVerified and image. Several fields the model marks as required are
  // optional here until registration (F-03.1) collects them.
  bio                   String?            @db.Text
  birthDate             DateTime?          @db.Date
  gender                Gender?
  phone                 String?            @db.VarChar(30)
  phoneVerifiedAt       DateTime?
  preferredLanguage     Language           @default(CS)
  prefersOnlineEvents   Boolean            @default(false)
  status                UserStatus         @default(ACTIVE)
  travelRadiusKm        Int?
  onboardingCompletedAt DateTime?
  // F-04.8: how many wizard steps (activities, location, profile) are done or
  // skipped, so an interrupted wizard resumes at the first open one.
  onboardingStepsDone   Int                @default(0)
  termsAcceptedAt       DateTime?
  termsVersion          String?            @db.VarChar(20)
  disabledNotifications NotificationType[] @default([])

  // Model datatype `Location` (private): where the user lives, and a temporary
  // place (e.g. on holiday) that is valid until `temporaryLocationValidUntil`.
  homeStreet     String?  @db.VarChar(200)
  homeCity       String?  @db.VarChar(100)
  homePostalCode String?  @db.VarChar(20)
  homeCountry    String?  @db.VarChar(100)
  homeDistrict   String?  @db.VarChar(100)
  homePlaceName  String?  @db.VarChar(200)
  homeLatitude   Decimal? @db.Decimal(9, 6)
  homeLongitude  Decimal? @db.Decimal(9, 6)

  temporaryStreet             String?   @db.VarChar(200)
  temporaryCity               String?   @db.VarChar(100)
  temporaryPostalCode         String?   @db.VarChar(20)
  temporaryCountry            String?   @db.VarChar(100)
  temporaryDistrict           String?   @db.VarChar(100)
  temporaryPlaceName          String?   @db.VarChar(200)
  temporaryLatitude           Decimal?  @db.Decimal(9, 6)
  temporaryLongitude          Decimal?  @db.Decimal(9, 6)
  temporaryLocationValidUntil DateTime?

  interests UserActivity[]

  blockedUsers User[] @relation("UserBlocks")
  blockedBy    User[] @relation("UserBlocks")

  organizedEvents       Event[]                @relation("EventOrganizer")
  coOrganizedEvents     Event[]                @relation("EventCoOrganizers")
  participations        Participation[]
  participationRequests ParticipationRequest[]
  groupMemberships      GroupMembership[]
  membershipRequests    MembershipRequest[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}
