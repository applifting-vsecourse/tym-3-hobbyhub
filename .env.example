# Root env for the production stack (docker-compose.yml).
# Local test: cp .env.example .env && docker compose up --build
#
# NOT used by `pnpm dev` — that reads apps/backend/.env and apps/frontend/.env.
# The backend has more knobs than are listed here (SMTP, logging, …); see
# apps/backend/.env.example for the full set. Anything you add to this file is
# forwarded to the backend container as-is.

# --- Database (compose creates it with these credentials) ---
POSTGRES_USER=quacker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=quacker

# --- Auth ---
# Generate for real deployments: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_me

# --- Public URLs (the two domains this stack answers on) ---
# BACKEND_URL is also baked into the frontend bundle at BUILD time, so
# changing it needs a rebuild, not just a restart.
# The backend accepts browser requests only from these two origins.
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050

# --- Host ports (Coolify routes through its proxy; these are for local runs) ---
BACKEND_HOST_PORT=4050
FRONTEND_HOST_PORT=3050

# --- Mail (unset = emails print to the backend log) ---
RESEND_API_KEY=
EMAIL_FROM="Quacker <onboarding@resend.dev>"
# Mailjet over SMTP (F-09.5): user name = API key, password = secret key, the
# sender an address of the domain verified in Mailjet (SPF + DKIM).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# The outbox's limits (ADR-0018); these are the defaults, for Mailjet's free plan.
EMAIL_DAILY_LIMIT=200
EMAIL_CRITICAL_RESERVE_PERCENT=20
EMAIL_RECIPIENT_HOURLY_LIMIT=10
